# CertiFlow Environment Variables Example
NODE_ENV=development
PORT=5000

# Database
# For Local SQLite:
DATABASE_URL="file:./dev.db"
# For Docker / PostgreSQL:
# DATABASE_URL="postgresql://certiflow:certiflow_secret@postgres:5432/certiflow_db?schema=public"

# Authentication
JWT_SECRET="certiflow_jwt_super_secret_production_key_987654"

# Redis and BullMQ
REDIS_URL="redis://localhost:6379"

# Business Rules
LARGE_BATCH_THRESHOLD=50
SLA_HOURS_DISTRICT=48
SLA_HOURS_STATE=48

# Frontend & CORS
CORS_ORIGIN="http://localhost:5173"

# Simulation Parameters
SIMULATE_WHATSAPP_FAILURE_RATE=0.2
SIMULATE_WHATSAPP_DELAY_MS=300
PUBLIC_VERIFY_RATE_LIMIT=100
