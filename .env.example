# CertiFlow Environment Variables Template

# Application Environment
NODE_ENV=development
PORT=5000

# Database Connection
# For Local SQLite testing:
DATABASE_URL="file:./dev.db"
# For Docker Compose / Production PostgreSQL:
# DATABASE_URL="postgresql://certiflow:certiflow_secret@postgres:5432/certiflow_db?schema=public"

# Authentication Security
JWT_SECRET="certiflow_production_secret_key_2026_jwt_token_secure"

# Asynchronous Background Processing
REDIS_URL="redis://localhost:6379"

# Statutory Governance Rules
LARGE_BATCH_THRESHOLD=50
SLA_HOURS_DISTRICT=48
SLA_HOURS_STATE=48

# Web Client and CORS
CORS_ORIGIN="http://localhost:5173"

# Simulation Parameters
SIMULATE_WHATSAPP_FAILURE_RATE=0.2
SIMULATE_WHATSAPP_DELAY_MS=300
PUBLIC_VERIFY_RATE_LIMIT=100
